# Absolute public origin of this deployment. Inlined into the bundle at build
# time (NEXT_PUBLIC_*), so it must be present when `next build` runs — not only
# at container start. Canonical host is aimtp.net.
#
# Note that the site does not own that whole origin: /schemas/, /spec/ and
# /runtime/schemas/ are the protocol schemas' $id namespace and are served by
# the reverse proxy ahead of this app. See docs/deployment.md.
NEXT_PUBLIC_SITE_URL=https://aimtp.net

# Internal origin of the Agent Trust Gateway demo service, which backs
# /demo/agent-trust-gateway. Read on the server only — deliberately not
# NEXT_PUBLIC_*, so it is never inlined into the browser bundle and the sidecar
# is never addressable from a client.
#
# Unset, the page renders a labelled "unavailable" state and points at the
# recorded run at /demo. It never fakes a live Gateway, so leaving this out is a
# supported deployment rather than a broken one.
#
# The service is `docker compose -f docker-compose.demo.yml up` in the protocol
# repository, attached to the shared `aimtp-demo` network.
# AIMTP_DEMO_ORIGIN=http://aimtp-gateway-demo:8090
